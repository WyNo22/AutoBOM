{
  "manifest_version": 3,
  "name": "AutoBOM",
  "version": "0.0.1",
  "description": "Capturez des références produit et envoyez-les directement dans AutoBOM.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://*.tolery.fr/*",
    "https://*.tolery.com/*",
    "https://*.xometry.eu/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.com/*",
    "https://*.misumi-ec.com/*",
    "https://*.rs-online.com/*",
    "https://*.rsonline.fr/*",
    "https://*.leroymerlin.fr/*",
    "https://*.bricovis.fr/*",
    "https://*.123roulements.com/*",
    "https://*.norelem.com/*",
    "https://*.aliexpress.com/*",
    "https://*.alibaba.com/*",
    "https://*.ebay.fr/*",
    "https://*.ebay.com/*",
    "https://*.leboncoin.fr/*",
    "https://*.manomano.fr/*",
    "https://*.conrad.fr/*",
    "https://*.farnell.com/*",
    "https://*.mouser.fr/*",
    "https://*.digikey.fr/*",
    "https://*.wurth.fr/*",
    "https://*.bricozor.com/*",
    "https://*.bricodepot.fr/*",
    "https://*.castorama.fr/*",
    "https://*.igus.fr/*",
    "https://*.festo.com/*",
    "https://*.smc.eu/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "https://auto-bom-web-soh3.vercel.app/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoBOM",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.tolery.fr/*", "https://*.tolery.com/*"],
      "js": ["content/tolery.js"]
    },
    {
      "matches": ["https://*.amazon.fr/*", "https://*.amazon.com/*"],
      "js": ["content/amazon.js"]
    },
    {
      "matches": ["https://*.misumi-ec.com/*"],
      "js": ["content/misumi.js"]
    },
    {
      "matches": ["https://*.rs-online.com/*", "https://*.rsonline.fr/*"],
      "js": ["content/rs.js"]
    },
    {
      "matches": [
        "https://*.xometry.eu/*",
        "https://*.leroymerlin.fr/*",
        "https://*.bricovis.fr/*",
        "https://*.123roulements.com/*",
        "https://*.norelem.com/*",
        "https://*.aliexpress.com/*",
        "https://*.alibaba.com/*",
        "https://*.ebay.fr/*",
        "https://*.ebay.com/*",
        "https://*.leboncoin.fr/*",
        "https://*.manomano.fr/*",
        "https://*.conrad.fr/*",
        "https://*.farnell.com/*",
        "https://*.mouser.fr/*",
        "https://*.digikey.fr/*",
        "https://*.wurth.fr/*",
        "https://*.bricozor.com/*",
        "https://*.bricodepot.fr/*",
        "https://*.castorama.fr/*",
        "https://*.igus.fr/*",
        "https://*.festo.com/*",
        "https://*.smc.eu/*"
      ],
      "js": ["content/generic.js"]
    }
  ]
}
